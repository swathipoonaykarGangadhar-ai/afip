# Copy to .env and fill in for production. Every one of these is
# optional -- the app runs fully functional without any of them set
# (SQLite checkpointing, template narration, no tracing).

# --- LLM narration (Claude) ---
# If unset, narration.py falls back to deterministic templates.
ANTHROPIC_API_KEY=

# --- Checkpointing ---
# If unset, falls back to a local SQLite file (afip_checkpoints.sqlite).
# Required for real production use so investigation state (including
# pending human-approval gates) survives process restarts/multi-instance
# deployment.
DATABASE_URL=postgresql://user:password@host:5432/afip

# --- Graph store (Neo4j) ---
# If unset, falls back to an in-memory NetworkX graph rebuilt from
# synthetic data on every process start -- fine for demo, not for
# production (no persistence, no real transaction data).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Observability (Langfuse) ---
# If unset, tracing is a true no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
